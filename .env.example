# neatHack LiteLLM proxy (OpenAI-compatible). Get the key from your team check-in email.
OPENAI_BASE_URL=https://<litellm-proxy-host>/v1
OPENAI_API_KEY=sk-...
JANGKAU_MODEL=claude-sonnet

# neatlogs (traces are only exported when this is set)
NEATLOGS_API_KEY=

# tag each run so before/after traces are easy to compare in neatlogs
JANGKAU_VERSION=v2
