# neatHack LiteLLM key: claim it at https://neatlogs.com/hackathon/models (leader email OTP)
LITELLM_API_KEY=
# claude-sonnet-4.6 | claude-opus-4.6 | claude-haiku | nova-pro | nova-lite | nova-micro | nova-2-lite
JANGKAU_MODEL=claude-haiku
JANGKAU_ESCALATE_MODEL=claude-sonnet-4.6

# neatlogs project key from https://app.neatlogs.com (traces are only exported when set)
NEATLOGS_API_KEY=

# tag each run so before/after traces are easy to compare in neatlogs
JANGKAU_VERSION=v2
# optional: link reports, PRs and stamps to the trace in the dashboard ({trace} is replaced)
# NEATLOGS_TRACE_URL=https://app.neatlogs.com/traces/{trace}?orgId=<org>&projectId=<project>
